{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1160px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base",      "color": "#0d0d0d", "name": "Base" },
        { "slug": "surface",   "color": "#161616", "name": "Surface" },
        { "slug": "surface-2", "color": "#242424", "name": "Surface 2" },
        { "slug": "contrast",  "color": "#f0ede6", "name": "Contrast" },
        { "slug": "muted",     "color": "#888880", "name": "Muted" },
        { "slug": "accent",    "color": "#c8a45a", "name": "Accent Gold" },
        { "slug": "forest",    "color": "#4f6149", "name": "Forest Green" },
        { "slug": "white",     "color": "#ffffff", "name": "White" },
        { "slug": "black",     "color": "#000000", "name": "Black" }
      ],
      "gradients": [
        {
          "slug": "dark-fade-up",
          "gradient": "linear-gradient(0deg, rgba(13,13,13,1) 0%, rgba(13,13,13,0) 100%)",
          "name": "Dark Fade Up"
        },
        {
          "slug": "dark-overlay",
          "gradient": "linear-gradient(180deg, rgba(13,13,13,0.4) 0%, rgba(13,13,13,0.85) 100%)",
          "name": "Dark Overlay"
        },
        {
          "slug": "accent-to-forest",
          "gradient": "linear-gradient(135deg, #c8a45a 0%, #4f6149 100%)",
          "name": "Accent to Forest"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "slug": "xs",  "size": "0.75rem",  "name": "XS",  "fluid": false },
        { "slug": "sm",  "size": "0.875rem", "name": "SM",  "fluid": false },
        { "slug": "md",  "size": "1rem",     "name": "MD",  "fluid": false },
        { "slug": "lg",  "size": "1.125rem", "name": "LG",  "fluid": false },
        { "slug": "xl",  "size": "1.5rem",   "name": "XL",  "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "2xl", "size": "2rem",     "name": "2XL", "fluid": { "min": "1.5rem",  "max": "2rem" } },
        { "slug": "3xl", "size": "2.75rem",  "name": "3XL", "fluid": { "min": "2rem",    "max": "2.75rem" } },
        { "slug": "4xl", "size": "3.75rem",  "name": "4XL", "fluid": { "min": "2.5rem",  "max": "3.75rem" } },
        { "slug": "5xl", "size": "5.5rem",   "name": "5XL", "fluid": { "min": "3rem",    "max": "5.5rem" } }
      ],
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif",
          "name": "Playfair Display",
          "slug": "playfair"
        },
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Inter",
          "slug": "inter"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem",  "name": "2" },
        { "slug": "20", "size": "1rem",    "name": "4" },
        { "slug": "30", "size": "1.5rem",  "name": "6" },
        { "slug": "40", "size": "2rem",    "name": "8" },
        { "slug": "50", "size": "3rem",    "name": "12" },
        { "slug": "60", "size": "5rem",    "name": "20" },
        { "slug": "70", "size": "8rem",    "name": "32" },
        { "slug": "80", "size": "12rem",   "name": "48" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "blocks": {
      "core/button":    { "border": { "radius": true } },
      "core/pullquote": { "border": { "color": true, "radius": true, "style": true, "width": true } }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--5xl)",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.05"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.1"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "letterSpacing": "-0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "600"
        }
      },
      "h6": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase",
          "lineHeight": "1"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--contrast)" },
          "typography": { "textDecoration": "underline" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--base)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "2.25rem",
            "right": "2.25rem"
          }
        },
        "border": { "radius": "0" },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "600",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
          }
        }
      },
      "core/post-excerpt": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "600",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--surface-2)" },
        "border": { "color": "var(--wp--preset--color--surface-2)", "width": "1px" }
      },
      "core/pullquote": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontStyle": "italic"
        },
        "border": { "color": "var(--wp--preset--color--accent)", "width": "2px" }
      },
      "core/quote": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "border": {
          "color": "var(--wp--preset--color--accent)",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } }
      },
      "core/code": {
        "color": {
          "background": "var(--wp--preset--color--surface)",
          "text": "var(--wp--preset--color--accent)"
        },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" },
        "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.5rem", "right": "1.5rem" } },
        "border": { "color": "var(--wp--preset--color--surface-2)", "style": "solid", "width": "1px" }
      },
      "core/image": {
        "filter": { "duotone": "unset" }
      }
    }
  },
  "customTemplates": [
    { "name": "blank",       "title": "Blank",           "postTypes": ["page", "post"] },
    { "name": "no-title",    "title": "No Title",        "postTypes": ["page"] },
    { "name": "full-width",  "title": "Full Width",      "postTypes": ["page", "post"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
