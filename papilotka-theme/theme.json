{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1160px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base",        "color": "#0a0a0a", "name": "Base" },
        { "slug": "surface",     "color": "#111111", "name": "Surface" },
        { "slug": "surface-2",   "color": "#1e1e1e", "name": "Surface 2" },
        { "slug": "navy",        "color": "#0f2259", "name": "Navy" },
        { "slug": "contrast",    "color": "#ffffff", "name": "Contrast" },
        { "slug": "muted",       "color": "#888888", "name": "Muted" },
        { "slug": "accent",      "color": "#FF3C00", "name": "Accent Orange" },
        { "slug": "accent-dark", "color": "#E63500", "name": "Accent Dark" },
        { "slug": "white",       "color": "#ffffff", "name": "White" },
        { "slug": "black",       "color": "#000000", "name": "Black" }
      ],
      "gradients": [
        {
          "slug": "hero",
          "gradient": "radial-gradient(ellipse at 30% 50%, #1A3A8F 0%, #0F2259 60%, #0a0a0a 100%)",
          "name": "Hero Blue"
        },
        {
          "slug": "dark-fade",
          "gradient": "linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,1) 100%)",
          "name": "Dark Fade"
        },
        {
          "slug": "navy-dark",
          "gradient": "linear-gradient(135deg, #0f2259 0%, #0a0a0a 100%)",
          "name": "Navy to Dark"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "slug": "xs",  "size": "0.75rem",  "name": "XS",  "fluid": false },
        { "slug": "sm",  "size": "0.875rem", "name": "SM",  "fluid": false },
        { "slug": "md",  "size": "1rem",     "name": "MD",  "fluid": false },
        { "slug": "lg",  "size": "1.125rem", "name": "LG",  "fluid": false },
        { "slug": "xl",  "size": "1.5rem",   "name": "XL",  "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "2xl", "size": "2rem",     "name": "2XL", "fluid": { "min": "1.5rem",  "max": "2rem" } },
        { "slug": "3xl", "size": "2.75rem",  "name": "3XL", "fluid": { "min": "2rem",    "max": "2.75rem" } },
        { "slug": "4xl", "size": "3.75rem",  "name": "4XL", "fluid": { "min": "2.5rem",  "max": "3.75rem" } },
        { "slug": "5xl", "size": "5.5rem",   "name": "5XL", "fluid": { "min": "2.75rem", "max": "5.5rem" } }
      ],
      "fontFamilies": [
        {
          "fontFamily": "'Poppins', 'Helvetica Neue', Arial, sans-serif",
          "name": "Poppins",
          "slug": "poppins"
        },
        {
          "fontFamily": "'Work Sans', 'Helvetica Neue', Arial, sans-serif",
          "name": "Work Sans",
          "slug": "work-sans"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem",  "name": "2" },
        { "slug": "20", "size": "1rem",    "name": "4" },
        { "slug": "30", "size": "1.5rem",  "name": "6" },
        { "slug": "40", "size": "2rem",    "name": "8" },
        { "slug": "50", "size": "3rem",    "name": "12" },
        { "slug": "60", "size": "5rem",    "name": "20" },
        { "slug": "70", "size": "8rem",    "name": "32" },
        { "slug": "80", "size": "12rem",   "name": "48" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true, "radius": true, "style": true, "width": true
    },
    "dimensions": { "aspectRatio": true, "minHeight": true },
    "blocks": {
      "core/button":    { "border": { "radius": true } },
      "core/pullquote": { "border": { "color": true, "radius": true, "style": true, "width": true } }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text":       "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--work-sans)",
      "fontSize":   "var(--wp--preset--font-size--md)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": {
        "top": "0", "bottom": "0",
        "left":  "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--5xl)", "fontWeight": "800", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--4xl)", "fontWeight": "700", "letterSpacing": "-0.015em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)", "fontWeight": "600" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)",  "fontWeight": "600", "lineHeight": "1.3" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)",  "fontWeight": "600" } },
      "h6": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily":    "var(--wp--preset--font-family--poppins)",
          "fontSize":      "var(--wp--preset--font-size--xs)",
          "fontWeight":    "700",
          "letterSpacing": "0.18em",
          "textTransform": "uppercase",
          "lineHeight":    "1"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text":       "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily":    "var(--wp--preset--font-family--poppins)",
          "fontSize":      "var(--wp--preset--font-size--sm)",
          "fontWeight":    "600",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "2rem", "right": "2rem" }
        },
        "border": { "radius": "24px" },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-dark)",
            "text":       "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontSize":   "var(--wp--preset--font-size--sm)",
          "fontWeight": "500"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
          }
        }
      },
      "core/post-excerpt": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": {
          "fontFamily":    "var(--wp--preset--font-family--poppins)",
          "fontSize":      "var(--wp--preset--font-size--xs)",
          "fontWeight":    "600",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily":    "var(--wp--preset--font-family--poppins)",
          "fontSize":      "var(--wp--preset--font-size--xs)",
          "fontWeight":    "700",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--surface-2)" },
        "border": { "color": "var(--wp--preset--color--surface-2)", "width": "1px" }
      },
      "core/pullquote": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontSize":   "var(--wp--preset--font-size--xl)",
          "fontStyle":  "italic"
        },
        "border": { "color": "var(--wp--preset--color--accent)", "width": "3px" }
      },
      "core/quote": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "border": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "0 0 0 3px" },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } }
      }
    }
  },
  "customTemplates": [
    { "name": "blank",      "title": "Blank",         "postTypes": ["page", "post"] },
    { "name": "full-width", "title": "Full Width",    "postTypes": ["page", "post"] },
    { "name": "no-title",   "title": "No Title",      "postTypes": ["page"] },
    { "name": "portfolio",  "title": "Portfolio Grid","postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
